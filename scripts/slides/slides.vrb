\frametitle{Backup: reproducibility}
\footnotesize
\begin{verbatim}
python main.py --stage all --quick --sim-bins 20000 --sim-genes 4000      # run A
python debug_norho.py; python debug_norho_all.py; python debug_floor.py   # runs C, D, E
python sim_paper.py --outdir sim_paper
python run_replication.py --sim-dir sim_paper --fit-dir fit_paper --kernels linear \
       --n-chains 1 --n-iter 1000 --burn-in 500 --thin 5                  # run F
python run_replication.py ... --fit-dir fit_paper_norho --no-rho          # run G
python make_slide_assets.py; cd slides; pdflatex slides.tex
\end{verbatim}
